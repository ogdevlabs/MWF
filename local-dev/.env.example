# local-dev/.env — Local development credentials
# Copy this file to local-dev/.env, fill in your values, never commit .env.
#
# Scripts (dev.sh, run-mobile.sh, test-login.sh) source this file automatically.

# ── Supabase ──────────────────────────────────────────────────────────────────
# HOSTED: set to your Supabase project URL — dev.sh will skip local Docker.
# LOCAL:  leave blank — dev.sh auto-reads from `supabase status`.
SUPABASE_URL=https://rlcgtqagfdweisnxrasn.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# ── Google Sign-In ────────────────────────────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# ── RevenueCat ────────────────────────────────────────────────────────────────
REVENUECAT_APPLE_API_KEY=
REVENUECAT_GOOGLE_API_KEY=

# ── Integration test credentials ─────────────────────────────────────────────
# Used by: ./local-dev/test-login.sh
# Create a test user in Supabase dashboard → Authentication → Users → Add user
TEST_EMAIL=
TEST_PASSWORD=
