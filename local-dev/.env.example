# local-dev/.env — Local development credentials
# Copy to local-dev/.env, fill in values, never commit.
#
# Usage: scripts source this file automatically — no need to pass env vars manually.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Leave blank to auto-read from `supabase status` (recommended for local stack)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# ── Google Sign-In ────────────────────────────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials
# Web client ID (used by both iOS and Android for server-side auth)
GOOGLE_WEB_CLIENT_ID=

# iOS OAuth client ID (type: iOS)
GOOGLE_IOS_CLIENT_ID=

# ── RevenueCat ────────────────────────────────────────────────────────────────
REVENUECAT_APPLE_API_KEY=
REVENUECAT_GOOGLE_API_KEY=
